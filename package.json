{
  "name": "n8n-nodes-openagenthub",
  "version": "0.2.1",
  "description": "n8n community nodes for OpenAgentHub sessions and agent messaging",
  "license": "MIT",
  "author": {
    "name": "OpenAgentHub contributors",
    "url": "https://github.com/open-agenthub"
  },
  "homepage": "https://github.com/open-agenthub/n8n-nodes-openagenthub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-agenthub/n8n-nodes-openagenthub.git"
  },
  "bugs": {
    "url": "https://github.com/open-agenthub/n8n-nodes-openagenthub/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "openagenthub",
    "ai",
    "agent"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OpenAgentHubApi.credentials.js",
      "dist/credentials/OpenAgentHubEeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OpenAgentHub/OpenAgentHub.node.js",
      "dist/nodes/OpenAgentHub/OpenAgentHubTrigger.node.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "0.51.4",
    "@types/node": "22.20.5",
    "n8n-workflow": "2.16.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "axios": "1.20.0",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "qs": "6.16.0"
  }
}
